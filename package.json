{
  "name": "voz-e-folha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:api": "esbuild server/vercelEntry.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "build": "npm run build:api && vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && oxlint src server scripts server.ts vite.config.ts && eslint firestore.rules",
    "test": "tsx --test src/lib/*.test.ts server/*.test.ts firestore.rules.test.ts",
    "illustrations:prerender": "tsx scripts/prerender-illustrations.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^3.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
